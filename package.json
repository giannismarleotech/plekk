{
  "name": "plekk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/unpack-site.mjs && node scripts/patch-site.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/unpack-site.mjs && node scripts/patch-site.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "build:static": "node scripts/build-static.mjs",
    "test": "tsx scripts/test-abonnement.ts",
    "check:site": "node scripts/check-site.mjs",
    "e2e": "node scripts/e2e.mjs",
    "site:patch": "node scripts/patch-site.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mollie/api-client": "^4.6.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "type": "module"
}
